. // #4
. // life events and mental distress: Figure 2    
. foreach v in $events_yes{
  2.         gen `v'3 = 0 if none==1
  3.         replace `v'3 = 1 if `v'==1
  4.         replace `v'3 = 2 if `v'==0 & none==0
  5.         label define `v'3 0 "none" 1 "`v'" 2 "other"
  6.         label values `v'3 `v'3
  7.         tab `v'3, m
  8. }
