  3.         estimates store l1_`x'
  4.         margins SURVMNTH if SEX == 1, post
  5.         estimates store l1_m_`x'
  6.         estimates restore l1_`x'
  7.         margins SURVMNTH if SEX == 2, post
  8.         estimates store l1_f_`x'
  9. }

