. // #3
. // by education, Figure A1
. forv x = 0/2 {
  2.         forv y = 1/3 {
  3.                 logit all_emp i.SURVMNTH##SEX if kidage == `x' & educ_small == `y' [pweight = FINALWT] 
  4.                 estimates store l2_`x'_`y'
  5.                 margins SURVMNTH if SEX == 1, post
  6.                 estimates store l2_m_`x'_`y'
  7.                 estimates restore l2_`x'_`y'
  8.                 margins SURVMNTH if SEX == 2, post
  9.                 estimates store l2_f_`x'_`y'
 10.         }
 11. }

