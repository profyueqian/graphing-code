. /*
> 0 - no measures
> 1 - recommend closing or all schools open with alterations resulting in significant differences compared to non-Covid-
> 19 operations
> 2 - require closing (only some levels or categories, eg just high school, or just public schools)
> 3 - require closing all levels
> */
. gen opandemic = pandemic

. replace pandemic = 1 if year==2021 & (c1m_schoolclosing==0 | c1m_schoolclosing==1)
